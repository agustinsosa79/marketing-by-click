# Copiá este archivo como .env.local para probar el panel en tu compu (npm run dev).
# En Vercel van solo las dos primeras, en Settings → Environment Variables del proyecto del panel.

# Contraseña para entrar al panel (mínimo 12 caracteres)
PANEL_PASSWORD=

# Token "fine-grained" de GitHub con acceso SOLO a este repo y permiso Contents: Read and write
GITHUB_TOKEN=

# --- Opcionales (ya tienen estos valores por defecto)
# GITHUB_REPO=agustinsosa79/marketing-by-click
# GITHUB_BRANCH=master

# --- Desarrollo: guarda en la carpeta del sitio en vez de GitHub (no funciona en Vercel)
# PANEL_STORAGE=local
