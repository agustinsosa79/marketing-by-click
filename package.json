{
  "name": "marketingbyclic",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "scrape": "tsx scripts/scrape.ts && node scripts/identify-fonts.mjs",
    "optimize-media": "node scripts/optimize-media.mjs",
    "qa:preloader": "node scripts/qa-preloader.mjs",
    "qa:page": "node scripts/qa-page.mjs",
    "reference:frames": "node scripts/extract-reference-frames.mjs",
    "compare:preloader": "tsx scripts/compare-preloader.ts",
    "check:lenis": "node scripts/check-lenis.mjs",
    "qa:sections": "node scripts/qa-sections.mjs",
    "qa:interactions": "node scripts/qa-interactions.mjs",
    "record": "node scripts/record-scroll.mjs",
    "lighthouse": "bash scripts/lighthouse.sh"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "ffmpeg-static": "^5.3.0",
    "marked": "^18.0.14",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "yaml": "^2.9.1"
  }
}
